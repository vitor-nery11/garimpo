# App
APP_NAME=Garimpo API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://garimpo:garimpo_secret@localhost:5432/garimpo

# Redis
REDIS_URL=redis://localhost:6379/0
DEBOUNCE_SECONDS=10
LOCK_TTL_SECONDS=30

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=garimpo-evo-key-2026
EVOLUTION_INSTANCE_NAME=garimpo_prospeccao
EVOLUTION_WEBHOOK_SECRET=

# Captação (Google Places ou Serper.dev)
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=

# IA SDR (OpenAI ou Google Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alertas
ALERT_WHATSAPP_PHONE=5573988323477
TIMEZONE=America/Sao_Paulo
